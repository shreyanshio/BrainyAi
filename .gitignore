# Brainy AI — Git Ignore Rules

# Environment variables & secrets
.env
.env*.local
.env.production
.env.development
*.env
.auth_secret

# Local state & runtime cache files
user_quotas.json
suspended_users.json
security.log
*.log

# Node.js dependencies & build outputs
node_modules/
.next/
out/
.open-next/
dist/
build/
.wrangler/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

