# ==============================================================================
#   BRAINY AI — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root and fill in your values:
#   cp .env.example .env
#
# NOTE: Never commit `.env` or any file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Backend & Security Gateway
# ------------------------------------------------------------------------------
# Server port for the Flask REST API (default: 5000)
PORT=5000

# Secret key used for signing HS256 Bearer tokens and hardening session cookies.
# Generate a cryptographically secure 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Public URL of the frontend application (used in auth redirects and Telegram links)
FRONTEND_URL=https://brainyai.cenai.workers.dev

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=https://brainyai.cenai.workers.dev,http://localhost:3000,http://127.0.0.1:3000

# Cookie security settings (Set SESSION_COOKIE_SECURE=True in production with HTTPS)
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Configuration (Browser-Facing)
# ------------------------------------------------------------------------------
# Base URL of the Flask API backend.
# In local development, leave empty or point to http://localhost:5000
# In production, set to your backend deployment (e.g., Railway URL)
NEXT_PUBLIC_API_URL=https://brainyai-production.up.railway.app

# ------------------------------------------------------------------------------
# 3. Administrative Control Panel Access Control (/admin)
# ------------------------------------------------------------------------------
# Comma-separated list of user identifiers granted administrator privileges.
# Access to /admin and /api/admin/* is denied for all other users.
ADMIN_USER_IDS=7544007323
ADMIN_USERNAMES=shreyanshio,admin
ADMIN_EMAILS=admin@brainy.study

# ------------------------------------------------------------------------------
# 4. Supabase PostgreSQL Database (Service Role)
# ------------------------------------------------------------------------------
# Supabase Project URL (shown in the project's Connect dialog)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret API key (maps to service_role and bypasses RLS).
# Set this only in Railway's Flask and bot service variables. Never expose it
# as NEXT_PUBLIC_*, commit a real value, or put it in browser code.
SUPABASE_SERVICE_KEY=sb_secret_your_private_backend_key_here
# Legacy name accepted by this repository if a service already uses it:
# SUPABASE_KEY=your_legacy_service_role_jwt_here

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Web Authentication)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Public Google client ID embedded in the static frontend build (same web client)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 6. Telegram Bot Integration
# ------------------------------------------------------------------------------
# Bot token obtained from Telegram's @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram numeric user ID of the primary bot administrator/owner
OWNER_ID=7544007323

# Web App URL configured in Telegram Mini App menu button
WEB_APP_URL=https://brainyai.cenai.workers.dev

# ------------------------------------------------------------------------------
# 7. Multi-Provider AI API Keys (Automatic Routing & Fallbacks)
# ------------------------------------------------------------------------------
# At least one provider (e.g. Groq or Gemini) is required for AI responses.
# The system supports key pooling (e.g., GROQ_API_KEY_1, GROQ_API_KEY_2).

# Groq (High-speed Llama 3.3 70B & DeepSeek reasoning)
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...

# Google Gemini (Reasoning & STEM problem solving)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# GEMINI_API_KEY_1=AIzaSy_...

# OpenRouter (DeepSeek R1 / V3 and broad model fallback)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENROUTER_API_KEY_1=sk-or-v1-...

# Tavily AI (Real-time live search grounding with citations)
TAVILY_API_KEY=tvly-your_tavily_api_key_here
# TAVILY_API_KEY_1=tvly-...

# Additional Optional Providers (Key pools 1-5 supported):
# CEREBRAS_API_KEY_1=csk-...
# SAMBANOVA_API_KEY_1=...
# TOGETHER_API_KEY_1=...
# MISTRAL_API_KEY_1=...
# OPENAI_API_KEY_1=sk-...
# NVIDIA_API_KEY_1=nvapi-...

# ------------------------------------------------------------------------------
# 8. Server-Authoritative Rate Limiting & Usage Quota
# ------------------------------------------------------------------------------
# Maximum number of queries allowed per user within the quota window (default: 30)
GLOBAL_MESSAGE_LIMIT=30

# Duration of the quota reset window in hours (default: 5)
QUOTA_WINDOW_HOURS=5
