# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   BRAINY AI — Environment Variables Template (.env.example)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# ── Flask & Web Server Configuration ──
SECRET_KEY=your_secret_key_here
PORT=5000

# ── Telegram Bot Configuration ──
TELEGRAM_TOKEN=your_telegram_bot_token_here
OWNER_ID=123456789

# ── Supabase Configuration (REST API) ──
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# ── Google OAuth Configuration ──
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── AI Model Provider Keys (Groq, Gemini, DeepSeek, etc.) ──
GROQ_API_KEY_1=gsk_your_groq_api_key_here
# GROQ_API_KEY_2=gsk_your_second_key_here

# GEMINI_API_KEY_1=AIzaSy...
# DEEPSEEK_API_KEY_1=sk-...
# TAVILY_API_KEY_1=tvly-...
# Multi-provider routing fallbacks (optional: GROQ_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY)
